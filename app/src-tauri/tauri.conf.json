{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vangers - Soup Supervisor",
  "version": "0.1.0",
  "identifier": "com.caiiiycuk.github.vangers.gp",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vangers: Soup Supervisor",
        "width": 1280,
        "height": 720,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Vangers: Soup Supervisor",
    "longDescription": "Vangers: Soup Supervisor — a unique video game that combines elements of the racing and role-playing genres. Travel across surreal alien worlds and uncover their secrets.",
    "copyright": "Copyright (c) 1998 K-D LAB. Released under GPLv3.",
    "publisher": "K-D LAB",
    "homepage": "https://github.com/caiiiycuk/vss",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
